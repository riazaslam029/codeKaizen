# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Neon PostgreSQL. `neon deploy` / `neon env pull` writes these into .env.local automatically.
# Pooled endpoint (-pooler) for app queries; direct endpoint for migrations (drizzle-kit, scripts/migrate.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing key, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Development-only seed passwords (min 8 chars). Used by `npm run db:seed`; never set these in production.
SEED_ADMIN_PASSWORD=""
SEED_EXAMINER_PASSWORD=""
SEED_CANDIDATE_PASSWORD=""
