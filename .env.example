# Variable NAMES only — never commit real values. Real files are git-ignored (.env*).
#
# Two env files, one per Neon branch:
#   .env.local             → DEVELOPMENT branch "dev". Loaded by `next dev`, seed, tests, db:migrate, db:status.
#                            Create/refresh: neon env pull --branch dev -s postgres
#   .env.neon.production   → PRODUCTION branch. Never auto-loaded by Next.js; used only by
#                            db:migrate:prod and db:status:prod.
#                            Create/refresh: neon env pull --branch production -s postgres --file .env.neon.production
# On Vercel, set the production values in Project Settings → Environment Variables instead.

# Neon Postgres (written by `neon env pull`)
DATABASE_URL=            # pooled endpoint (host contains -pooler) — app runtime queries
DATABASE_URL_UNPOOLED=   # direct endpoint — migrations / drizzle-kit only
NEON_BRANCH=             # branch name; scripts refuse to seed/test when this is "production"
NEON_BRANCH_ID=

# Session signing key, 32+ random characters. Use a DIFFERENT value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Development-only demo account passwords (min 8 chars), used by `npm run db:seed` on the dev branch.
# Never set these on Vercel or in .env.neon.production.
SEED_ADMIN_PASSWORD=
SEED_EXAMINER_PASSWORD=
SEED_CANDIDATE_PASSWORD=

# Optional: shows Admin / Examiner / Candidate quick-fill buttons on the login page (demo/judging only).
# Leave unset to hide demo credentials.
DEMO_LOGIN_PASSWORD=
